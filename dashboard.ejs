<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= config.siteName || 'Create Link' %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    body {
      background-color: #0f172a;
      color: #f8fafc;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    }
    .card-box {
      background-color: #1b263b;
      border: 1px solid #2d3748;
    }
    .input-field {
      background-color: #0f172a;
      border: 1px solid #334155;
      color: #f8fafc;
    }
    .input-field:focus {
      outline: none;
      border-color: #3b82f6;
      box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
    }
    .tab-active {
      background-color: #1e293b;
      border-bottom: 2px solid #3b82f6;
      color: #ffffff;
    }
    .tab-inactive {
      color: #94a3b8;
    }
    .tab-inactive:hover {
      color: #e2e8f0;
    }
  </style>
</head>
<body class="min-h-screen p-4 md:p-8">

  <!-- TOP NAV BAR -->
  <div class="max-w-4xl mx-auto flex items-center justify-between mb-8 pb-4 border-b border-slate-800">
    <div class="flex items-center space-x-3">
      <div class="w-10 h-10 rounded-xl bg-blue-600 flex items-center justify-center text-white font-bold text-xl shadow-lg shadow-blue-500/20">
        <i class="fa-solid fa-link"></i>
      </div>
      <div>
        <h1 class="text-xl font-bold tracking-tight text-white"><%= config.siteName %></h1>
        <p class="text-xs text-slate-400">100% Monetized Shortlink Engine</p>
      </div>
    </div>
    
    <div class="flex items-center space-x-3">
      <button onclick="toggleAdModal()" class="px-3.5 py-2 rounded-lg bg-amber-500/10 text-amber-400 border border-amber-500/30 text-xs font-semibold hover:bg-amber-500/20 transition flex items-center gap-2">
        <i class="fa-solid fa-ad"></i> Setting Kode Iklan
      </button>
    </div>
  </div>

  <!-- MAIN CREATOR CARD -->
  <div class="max-w-4xl mx-auto">
    
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-2xl font-bold text-white flex items-center gap-2">
        Create Link
      </h2>
      <span class="text-xs bg-slate-800 text-slate-400 px-3 py-1 rounded-full border border-slate-700 font-mono">
        <i class="fa-solid fa-gear text-blue-400 mr-1"></i> URL Formatting <span class="bg-blue-600 text-white text-[10px] px-1.5 py-0.5 rounded font-sans uppercase">NEW</span>
      </span>
    </div>

    <!-- TABS & CONTAINER CARD -->
    <div class="card-box rounded-2xl p-6 shadow-2xl">
      
      <!-- TABS SWITCHER -->
      <div class="flex border-b border-slate-700/60 mb-6">
        <button id="tabSingle" onclick="switchTab('single')" class="flex-1 py-3 text-center font-medium text-sm transition flex items-center justify-center gap-2 tab-active rounded-t-lg">
          <i class="fa-solid fa-link"></i> Single URL
        </button>
        <button id="tabBulk" onclick="switchTab('bulk')" class="flex-1 py-3 text-center font-medium text-sm transition flex items-center justify-center gap-2 tab-inactive rounded-t-lg">
          <i class="fa-solid fa-layer-group"></i> Bulk URL
        </button>
      </div>

      <!-- FORM CONTENT -->
      <form id="createLinkForm" onsubmit="handleCreateLink(event)">
        
        <!-- SELECT DOMAIN -->
        <div class="mb-5">
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2 flex items-center gap-1.5">
            <i class="fa-solid fa-globe text-blue-400"></i> Select Domain
          </label>
          <div class="relative">
            <select id="selectedDomain" class="w-full input-field px-4 py-3 rounded-xl text-sm appearance-none cursor-pointer pr-10">
              <% config.domains.forEach(function(dom) { %>
                <option value="<%= dom %>"><%= dom %></option>
              <% }); %>
              <option value="<%= host %>"><%= host %> (Default Current Host)</option>
            </select>
            <div class="absolute inset-y-0 right-0 flex items-center px-4 pointer-events-none text-slate-400">
              <i class="fa-solid fa-chevron-down text-xs"></i>
            </div>
          </div>
        </div>

        <!-- URL INPUT AREA -->
        <div class="mb-5">
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2 flex items-center gap-1.5">
            <i class="fa-solid fa-file-lines text-blue-400"></i> Enter URL(s)
          </label>
          <textarea id="urlInput" rows="5" placeholder="Paste link video/file di sini... (pisahkan baris baru untuk bulk URL)" class="w-full input-field px-4 py-3 rounded-xl text-sm font-mono placeholder:text-slate-500 focus:ring-0" required></textarea>
          <p class="text-[11px] text-slate-400 mt-1.5 flex items-center gap-1">
            <i class="fa-solid fa-circle-info text-slate-500"></i> Each link must be on a new line.
          </p>
        </div>

        <!-- CUSTOM ALIAS (SINGLE MODE ONLY) -->
        <div id="customAliasBox" class="mb-5">
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2 flex items-center gap-1.5">
            <i class="fa-solid fa-pen text-blue-400"></i> Custom Alias (Optional)
          </label>
          <input type="text" id="customAliasInput" placeholder="misal: video-viral-1" class="w-full input-field px-4 py-2.5 rounded-xl text-sm">
        </div>

        <!-- CAPTCHA SIMULATOR BADGE -->
        <div class="mb-6 p-3 bg-slate-900/60 rounded-xl border border-slate-800 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-6 h-6 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-xs">
              <i class="fa-solid fa-check"></i>
            </div>
            <div>
              <p class="text-xs font-semibold text-slate-200">Anti-Bot Verification</p>
              <p class="text-[10px] text-slate-400">Cloudflare Turnstile Verified</p>
            </div>
          </div>
          <span class="text-[10px] bg-slate-800 text-slate-400 px-2 py-1 rounded font-mono">Status: Ready</span>
        </div>

        <!-- SUBMIT BUTTON -->
        <button type="submit" id="btnSubmit" class="w-full py-3.5 px-6 bg-blue-600 hover:bg-blue-500 text-white font-bold rounded-xl transition duration-200 shadow-lg shadow-blue-600/30 flex items-center justify-center gap-2 text-base cursor-pointer">
          <i class="fa-solid fa-wand-magic-sparkles"></i> Create Links
        </button>

      </form>

    </div>

    <!-- RESULT & GENERATED LINKS PANEL -->
    <div id="resultCard" class="hidden mt-8 card-box rounded-2xl p-6 shadow-2xl border-emerald-500/30 border">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-bold text-emerald-400 flex items-center gap-2">
          <i class="fa-solid fa-circle-check"></i> Hasil Shortlink Berhasil Dibuat
        </h3>
        <button onclick="copyAllResults()" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-200 rounded-lg border border-slate-700 transition flex items-center gap-1.5">
          <i class="fa-solid fa-copy text-blue-400"></i> Salin Semua Link
        </button>
      </div>

      <div id="resultList" class="space-y-3 font-mono text-sm max-h-60 overflow-y-auto pr-1"></div>
    </div>

    <!-- LINK HISTORY TABLE -->
    <div class="mt-10 card-box rounded-2xl p-6 shadow-2xl">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-base font-bold text-white flex items-center gap-2">
          <i class="fa-solid fa-clock-rotate-left text-blue-400"></i> Riwayat Link Terbaru
        </h3>
        <span class="text-xs text-slate-400 font-mono">Total: <%= links.length %> Link</span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-slate-300">
          <thead class="bg-slate-900/80 text-slate-400 uppercase font-semibold text-[10px] tracking-wider border-b border-slate-800">
            <tr>
              <th class="p-3">ID / Kode</th>
              <th class="p-3">Hasil Shortlink</th>
              <th class="p-3">Link Asli</th>
              <th class="p-3 text-center">Klik</th>
              <th class="p-3 text-right">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/60 font-mono">
            <% if (links.length === 0) { %>
              <tr>
                <td colspan="5" class="p-6 text-center text-slate-500 font-sans text-sm">
                  Belum ada shortlink yang dibuat.
                </td>
              </tr>
            <% } else { %>
              <% links.forEach(function(item) { %>
                <tr class="hover:bg-slate-800/40 transition">
                  <td class="p-3 font-bold text-blue-400"><%= item.id %></td>
                  <td class="p-3">
                    <a href="<%= item.localDirectUrl %>" target="_blank" class="text-slate-200 hover:underline hover:text-blue-300 truncate max-w-xs block">
                      <%= item.shortUrl %>
                    </a>
                  </td>
                  <td class="p-3 text-slate-500 truncate max-w-xs" title="<%= item.originalUrl %>">
                    <%= item.originalUrl %>
                  </td>
                  <td class="p-3 text-center">
                    <span class="bg-blue-500/10 text-blue-400 px-2 py-0.5 rounded font-bold">
                      <%= item.clicks || 0 %>
                    </span>
                  </td>
                  <td class="p-3 text-right space-x-2 font-sans">
                    <button onclick="copyToClipboard('<%= item.shortUrl %>')" class="px-2 py-1 bg-slate-800 hover:bg-slate-700 text-slate-300 text-[11px] rounded transition" title="Copy Shortlink">
                      <i class="fa-solid fa-copy"></i>
                    </button>
                    <button onclick="deleteLink('<%= item.id %>')" class="px-2 py-1 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 text-[11px] rounded transition" title="Hapus Link">
                      <i class="fa-solid fa-trash-can"></i>
                    </button>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <!-- MODAL AD SETTINGS -->
  <div id="adModal" class="fixed inset-0 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4 hidden z-50">
    <div class="card-box w-full max-w-2xl rounded-2xl p-6 shadow-2xl relative border border-slate-700">
      <button onclick="toggleAdModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white">
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>

      <h3 class="text-lg font-bold text-white mb-2 flex items-center gap-2">
        <i class="fa-solid fa-rectangle-ad text-amber-400"></i> Pengaturan Kode Iklan (100% Milik Anda)
      </h3>
      <p class="text-xs text-slate-400 mb-5">
        Tempelkan script iklan milik Anda dari <b>Adsterra, Monetag, HilltopAds, PopAds, Google AdSense</b>, dll. 
      </p>

      <form onsubmit="handleSaveSettings(event)" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Durasi Timer Countdown (Detik)</label>
          <input type="number" id="settingTimer" value="<%= config.timerSeconds || 5 %>" min="1" max="60" class="w-full input-field px-4 py-2 rounded-xl text-sm">
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Script Iklan Banner Atas (HTML / JavaScript)</label>
          <textarea id="settingTopBanner" rows="3" class="w-full input-field px-4 py-2 rounded-xl text-xs font-mono"><%= config.ads.topBanner %></textarea>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Script Iklan Banner Bawah (HTML / JavaScript)</label>
          <textarea id="settingBottomBanner" rows="3" class="w-full input-field px-4 py-2 rounded-xl text-xs font-mono"><%= config.ads.bottomBanner %></textarea>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Script Popunder / Direct Link (Optional)</label>
          <textarea id="settingPopunder" rows="2" class="w-full input-field px-4 py-2 rounded-xl text-xs font-mono"><%= config.ads.popunderScript %></textarea>
        </div>

        <div class="pt-3 flex justify-end gap-3">
          <button type="button" onclick="toggleAdModal()" class="px-4 py-2 bg-slate-800 text-slate-300 text-xs font-semibold rounded-xl hover:bg-slate-700">Batal</button>
          <button type="submit" class="px-5 py-2 bg-blue-600 text-white text-xs font-bold rounded-xl hover:bg-blue-500 shadow-md">Simpan Setting Iklan</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    let activeTab = 'single';

    function switchTab(tab) {
      activeTab = tab;
      const tabSingle = document.getElementById('tabSingle');
      const tabBulk = document.getElementById('tabBulk');
      const customAliasBox = document.getElementById('customAliasBox');
      const urlInput = document.getElementById('urlInput');

      if (tab === 'single') {
        tabSingle.className = "flex-1 py-3 text-center font-medium text-sm transition flex items-center justify-center gap-2 tab-active rounded-t-lg";
        tabBulk.className = "flex-1 py-3 text-center font-medium text-sm transition flex items-center justify-center gap-2 tab-inactive rounded-t-lg";
        customAliasBox.style.display = 'block';
        urlInput.placeholder = "Paste link video/file tunggal di sini...";
        urlInput.rows = 3;
      } else {
        tabBulk.className = "flex-1 py-3 text-center font-medium text-sm transition flex items-center justify-center gap-2 tab-active rounded-t-lg";
        tabSingle.className = "flex-1 py-3 text-center font-medium text-sm transition flex items-center justify-center gap-2 tab-inactive rounded-t-lg";
        customAliasBox.style.display = 'none';
        urlInput.placeholder = "Paste banyak link di sini...\nContoh:\nhttps://site.com/video1.mp4\nhttps://site.com/video2.mp4";
        urlInput.rows = 6;
      }
    }

    async function handleCreateLink(e) {
      e.preventDefault();
      const btn = document.getElementById('btnSubmit');
      const urls = document.getElementById('urlInput').value;
      const selectedDomain = document.getElementById('selectedDomain').value;
      const customAlias = document.getElementById('customAliasInput').value;

      btn.disabled = true;
      btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Generating Links...';

      try {
        const res = await fetch('/api/create-link', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ urls, selectedDomain, customAlias })
        });
        const data = await res.json();

        if (data.success) {
          showResults(data.links);
        } else {
          alert('Error: ' + (data.error || 'Failed to create link'));
        }
      } catch (err) {
        alert('Server error: ' + err.message);
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-wand-magic-sparkles"></i> Create Links';
      }
    }

    function showResults(links) {
      const card = document.getElementById('resultCard');
      const list = document.getElementById('resultList');
      list.innerHTML = '';

      links.forEach(link => {
        const itemHtml = `
          <div class="p-3 bg-slate-900 rounded-xl border border-slate-800 flex items-center justify-between gap-3">
            <input type="text" readonly value="${link.shortUrl}" class="bg-transparent text-emerald-400 font-mono text-sm w-full outline-none">
            <button onclick="copyToClipboard('${link.shortUrl}')" class="px-3 py-1.5 bg-blue-600/20 text-blue-400 hover:bg-blue-600/30 text-xs font-semibold rounded-lg shrink-0 transition">
              <i class="fa-solid fa-copy mr-1"></i> Copy
            </button>
          </div>
        `;
        list.insertAdjacentHTML('beforeend', itemHtml);
      });

      card.classList.remove('hidden');
      card.scrollIntoView({ behavior: 'smooth' });
    }

    function copyToClipboard(text) {
      navigator.clipboard.writeText(text);
      alert('Link disalin ke clipboard:\n' + text);
    }

    function copyAllResults() {
      const inputs = document.querySelectorAll('#resultList input');
      const urls = Array.from(inputs).map(i => i.value).join('\n');
      navigator.clipboard.writeText(urls);
      alert(inputs.length + ' link disalin ke clipboard!');
    }

    async function deleteLink(id) {
      if (!confirm('Hapus shortlink ini?')) return;
      await fetch('/api/links/' + id, { method: 'DELETE' });
      location.reload();
    }

    function toggleAdModal() {
      document.getElementById('adModal').classList.toggle('hidden');
    }

    async function handleSaveSettings(e) {
      e.preventDefault();
      const timerSeconds = document.getElementById('settingTimer').value;
      const topBanner = document.getElementById('settingTopBanner').value;
      const bottomBanner = document.getElementById('settingBottomBanner').value;
      const popunderScript = document.getElementById('settingPopunder').value;

      await fetch('/api/settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ timerSeconds, topBanner, bottomBanner, popunderScript })
      });

      alert('Pengaturan iklan berhasil disimpan!');
      toggleAdModal();
      location.reload();
    }
  </script>
</body>
</html>
