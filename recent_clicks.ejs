<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Recent Clicks Log - <%= config.siteName %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    body { background-color: #0b1329; color: #f8fafc; font-family: system-ui, -apple-system, sans-serif; }
    .card-box { background-color: #111a33; border: 1px solid #1e2942; }
  </style>
</head>
<body class="min-h-screen flex text-slate-100">

  <!-- SIDEBAR -->
  <%- include('partials/sidebar') %>

  <!-- MAIN WRAPPER -->
  <div class="flex-1 flex flex-col min-w-0 bg-[#090e1d]">
    
    <!-- TOPBAR -->
    <%- include('partials/topbar') %>

    <!-- CONTENT -->
    <main class="p-6 md:p-10 flex-1 max-w-6xl mx-auto w-full">

      <div class="flex items-center justify-between mb-8">
        <div>
          <h1 class="text-3xl font-extrabold text-white tracking-tight">Recent Clicks</h1>
          <p class="text-xs text-slate-400 mt-1">Log aktivitas pengunjung yang mengklik shortlink Anda secara realtime.</p>
        </div>
      </div>

      <!-- CLICKS LOG TABLE -->
      <div class="card-box rounded-2xl p-6 shadow-2xl">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs text-slate-300">
            <thead class="bg-[#080e1c] text-slate-400 uppercase font-semibold text-[10px] tracking-wider border-b border-slate-800">
              <tr>
                <th class="p-3">Waktu</th>
                <th class="p-3">Kode Link</th>
                <th class="p-3">URL Shortlink</th>
                <th class="p-3">IP Pengunjung</th>
                <th class="p-3">Device / User Agent</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/60 font-mono">
              <% if (clicks.length === 0) { %>
                <tr>
                  <td colspan="5" class="p-6 text-center text-slate-500 font-sans text-sm">
                    Belum ada riwayat klik pengunjung.
                  </td>
                </tr>
              <% } else { %>
                <% clicks.forEach(function(item) { %>
                  <tr class="hover:bg-slate-800/40 transition">
                    <td class="p-3 text-slate-400 text-[11px]">
                      <%= new Date(item.timestamp).toLocaleString('id-ID') %>
                    </td>
                    <td class="p-3 font-bold text-blue-400"><%= item.linkId %></td>
                    <td class="p-3 text-slate-200 truncate max-w-xs"><%= item.shortUrl %></td>
                    <td class="p-3 text-emerald-400 font-bold"><%= item.ip %></td>
                    <td class="p-3 text-slate-500 truncate max-w-xs" title="<%= item.userAgent %>">
                      <%= item.userAgent %>
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

    </main>
  </div>
</body>
</html>
