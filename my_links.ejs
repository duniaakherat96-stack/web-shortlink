<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Links - <%= config.siteName %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    body { background-color: #0b1329; color: #f8fafc; font-family: system-ui, -apple-system, sans-serif; }
    .card-box { background-color: #111a33; border: 1px solid #1e2942; }
  </style>
</head>
<body class="min-h-screen flex text-slate-100">

  <!-- SIDEBAR -->
  <%- include('partials/sidebar') %>

  <!-- MAIN WRAPPER -->
  <div class="flex-1 flex flex-col min-w-0 bg-[#090e1d]">
    
    <!-- TOPBAR -->
    <%- include('partials/topbar') %>

    <!-- CONTENT -->
    <main class="p-6 md:p-10 flex-1 max-w-6xl mx-auto w-full">

      <div class="flex items-center justify-between mb-8">
        <div>
          <h1 class="text-3xl font-extrabold text-white tracking-tight">My Links</h1>
          <p class="text-xs text-slate-400 mt-1">Daftar kelola semua shortlink yang telah Anda buat.</p>
        </div>
        <a href="/create" class="px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold rounded-xl shadow-lg transition flex items-center gap-2">
          <i class="fa-solid fa-plus"></i> Create Link Baru
        </a>
      </div>

      <!-- LINKS TABLE -->
      <div class="card-box rounded-2xl p-6 shadow-2xl">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs text-slate-300">
            <thead class="bg-[#080e1c] text-slate-400 uppercase font-semibold text-[10px] tracking-wider border-b border-slate-800">
              <tr>
                <th class="p-3">ID / Kode</th>
                <th class="p-3">Shortlink URL</th>
                <th class="p-3">Target URL Asli</th>
                <th class="p-3 text-center">Total Klik</th>
                <th class="p-3 text-right">Aksi</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/60 font-mono">
              <% if (links.length === 0) { %>
                <tr>
                  <td colspan="5" class="p-6 text-center text-slate-500 font-sans text-sm">
                    Belum ada shortlink yang dibuat.
                  </td>
                </tr>
              <% } else { %>
                <% links.forEach(function(item) { %>
                  <tr class="hover:bg-slate-800/40 transition">
                    <td class="p-3 font-bold text-blue-400"><%= item.id %></td>
                    <td class="p-3">
                      <a href="<%= item.localDirectUrl %>" target="_blank" class="text-slate-200 hover:underline hover:text-blue-300 truncate max-w-xs block">
                        <%= item.shortUrl %>
                      </a>
                    </td>
                    <td class="p-3 text-slate-500 truncate max-w-xs" title="<%= item.originalUrl %>">
                      <%= item.originalUrl %>
                    </td>
                    <td class="p-3 text-center">
                      <span class="bg-blue-500/10 text-blue-400 px-2 py-0.5 rounded font-bold">
                        <%= item.clicks || 0 %>
                      </span>
                    </td>
                    <td class="p-3 text-right space-x-2 font-sans">
                      <button onclick="copyToClipboard('<%= item.shortUrl %>')" class="px-2.5 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 text-[11px] rounded-lg transition">
                        <i class="fa-solid fa-copy mr-1"></i> Copy
                      </button>
                      <button onclick="deleteLink('<%= item.id %>')" class="px-2.5 py-1.5 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 text-[11px] rounded-lg transition">
                        <i class="fa-solid fa-trash-can mr-1"></i> Hapus
                      </button>
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

    </main>
  </div>

  <script>
    function copyToClipboard(text) {
      navigator.clipboard.writeText(text);
      alert('Link disalin ke clipboard:\n' + text);
    }
    async function deleteLink(id) {
      if (!confirm('Hapus shortlink ini?')) return;
      await fetch('/api/links/' + id, { method: 'DELETE' });
      location.reload();
    }
  </script>
</body>
</html>
