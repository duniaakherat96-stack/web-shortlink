<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Analytics Overview - <%= config.siteName %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    body { background-color: #0b1329; color: #f8fafc; font-family: system-ui, -apple-system, sans-serif; }
    .card-box { background-color: #111a33; border: 1px solid #1e2942; }
  </style>
</head>
<body class="min-h-screen flex text-slate-100">

  <!-- SIDEBAR -->
  <%- include('partials/sidebar') %>

  <!-- MAIN WRAPPER -->
  <div class="flex-1 flex flex-col min-w-0 bg-[#090e1d]">
    
    <!-- TOPBAR -->
    <%- include('partials/topbar') %>

    <!-- CONTENT -->
    <main class="p-6 md:p-10 flex-1 max-w-6xl mx-auto w-full">

      <div class="flex items-center justify-between mb-8">
        <div>
          <h1 class="text-3xl font-extrabold text-white tracking-tight">Analytics Overview</h1>
          <p class="text-xs text-slate-400 mt-1">Laporan lengkap statistik performa klik & impresi shortlink Anda.</p>
        </div>
        <div class="flex items-center gap-2">
          <span class="px-3 py-1.5 bg-slate-800 text-xs text-slate-300 rounded-xl border border-slate-700 font-mono">
            <i class="fa-solid fa-calendar-days text-blue-400 mr-1.5"></i> 7 Hari Terakhir
          </span>
        </div>
      </div>

      <!-- 4 STAT CARDS -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
        
        <!-- CARD 1: TOTAL CLICKS -->
        <div class="card-box rounded-2xl p-5 relative overflow-hidden shadow-lg">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Total Klik</span>
            <div class="w-9 h-9 rounded-xl bg-blue-500/10 text-blue-400 flex items-center justify-center text-sm border border-blue-500/20">
              <i class="fa-solid fa-mouse-pointer"></i>
            </div>
          </div>
          <p class="text-3xl font-extrabold text-white mt-3 font-mono"><%= totalClicks %></p>
          <p class="text-[11px] text-emerald-400 mt-1 flex items-center gap-1 font-semibold">
            <i class="fa-solid fa-arrow-trend-up"></i> +100% Impresi ke Anda
          </p>
        </div>

        <!-- CARD 2: TODAY CLICKS -->
        <div class="card-box rounded-2xl p-5 relative overflow-hidden shadow-lg">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Klik Hari Ini</span>
            <div class="w-9 h-9 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center text-sm border border-emerald-500/20">
              <i class="fa-solid fa-bolt"></i>
            </div>
          </div>
          <p class="text-3xl font-extrabold text-white mt-3 font-mono"><%= todayClicks %></p>
          <p class="text-[11px] text-slate-400 mt-1">Realtime update</p>
        </div>

        <!-- CARD 3: TOTAL LINKS -->
        <div class="card-box rounded-2xl p-5 relative overflow-hidden shadow-lg">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Total Link Active</span>
            <div class="w-9 h-9 rounded-xl bg-purple-500/10 text-purple-400 flex items-center justify-center text-sm border border-purple-500/20">
              <i class="fa-solid fa-link"></i>
            </div>
          </div>
          <p class="text-3xl font-extrabold text-white mt-3 font-mono"><%= totalLinks %></p>
          <p class="text-[11px] text-purple-400 mt-1">Siap disebar</p>
        </div>

        <!-- CARD 4: TOP LINK PERFORMANCE -->
        <div class="card-box rounded-2xl p-5 relative overflow-hidden shadow-lg">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Top Link Klik</span>
            <div class="w-9 h-9 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center text-sm border border-amber-500/20">
              <i class="fa-solid fa-trophy"></i>
            </div>
          </div>
          <p class="text-xl font-extrabold text-amber-400 mt-3 font-mono truncate">
            <%= topLink ? topLink.id : '-' %>
          </p>
          <p class="text-[11px] text-slate-400 mt-1 truncate">
            <%= topLink ? (topLink.clicks + ' Klik') : 'Belum ada data' %>
          </p>
        </div>

      </div>

      <!-- CHART GRAPH -->
      <div class="card-box rounded-2xl p-6 shadow-2xl mb-8">
        <div class="flex items-center justify-between mb-6">
          <h3 class="text-base font-bold text-white flex items-center gap-2">
            <i class="fa-solid fa-chart-line text-blue-400"></i> Grafik Trend Klik 7 Hari Terakhir
          </h3>
        </div>
        <div class="h-64">
          <canvas id="clicksChart"></canvas>
        </div>
      </div>

    </main>
  </div>

  <script>
    const chartData = <%- JSON.stringify(last7Days) %>;
    const ctx = document.getElementById('clicksChart').getContext('2d');
    
    new Chart(ctx, {
      type: 'line',
      data: {
        labels: chartData.map(d => d.day),
        datasets: [{
          label: 'Jumlah Klik',
          data: chartData.map(d => d.count),
          borderColor: '#3b82f6',
          backgroundColor: 'rgba(59, 130, 246, 0.1)',
          fill: true,
          tension: 0.4,
          pointRadius: 4,
          pointBackgroundColor: '#3b82f6'
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          x: { grid: { color: 'rgba(255, 255, 255, 0.05)' }, ticks: { color: '#94a3b8' } },
          y: { grid: { color: 'rgba(255, 255, 255, 0.05)' }, ticks: { color: '#94a3b8' }, beginAtZero: true }
        }
      }
    });
  </script>
</body>
</html>
